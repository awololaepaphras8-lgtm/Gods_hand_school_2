# God's Hand International Model School - Environment Configuration
# Duplicate this file as .env.local for local development or enter these in Vercel Settings -> Environment Variables

# Supabase Cloud Database & Realtime Sync Credentials
# Obtain these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional: Custom API Base URL (if using external server or serverless proxy)
VITE_API_BASE_URL=
